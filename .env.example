# ==========================================================================
#  FOCUS (T1 Focus) — variables de entorno
#  Copia este archivo a .env.local (dev) y configura las mismas en Railway.
# ==========================================================================

# --- App ---
# URL pública de la app (sin slash final). En Railway usa el dominio asignado.
NEXT_PUBLIC_APP_URL=http://localhost:3000
TZ=America/Mexico_City

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# SOLO en servidor / worker. Nunca la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Cadena de conexión directa a Postgres de Supabase (para pg-boss / worker).
# Supabase → Project Settings → Database → Connection string (URI, con ?sslmode=require)
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres?sslmode=require

# --- Acceso (allowlist) ---
# Correos que pueden iniciar sesión. Coma-separados. Se valida server-side.
ALLOWED_EMAILS=antar@t1.com
# Dominio hosted de Google para el hint de OAuth (server).
GOOGLE_HOSTED_DOMAIN=t1.com
# Mismo dominio, expuesto al cliente para el botón de login.
NEXT_PUBLIC_GOOGLE_HOSTED_DOMAIN=t1.com

# --- Anthropic (IA) ---
ANTHROPIC_API_KEY=sk-ant-...
# Modelo. Por defecto el más capaz. Puedes cambiarlo a claude-sonnet-4-6 por costo.
ANTHROPIC_MODEL=claude-opus-4-8

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
# Canales (IDs, empiezan con C...). Se llenan tras crear los canales.
SLACK_DUDAS_CHANNEL_ID=C0XXXXXXX
SLACK_DAILY_CHANNEL_ID=C0YYYYYYY

# --- Google Calendar (mismo OAuth del login, vía Supabase Google provider) ---
# El client id/secret se configuran en Supabase Auth. Aquí solo si el backend
# necesita refrescar tokens directamente.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Calendario donde se escribe la plantilla. 'primary' = calendario principal.
GOOGLE_CALENDAR_ID=primary

# --- Transcripción (Fase 3) ---
# Deepgram recomendado (es-MX + diarización). Opcional: la app funciona sin él.
DEEPGRAM_API_KEY=

# --- Cifrado de tokens OAuth en reposo (32 bytes en hex = 64 chars) ---
# Genera con: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# --- Web Push (notificaciones PWA) ---
# Genera con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:antar@t1.com

# --- Seguridad de cron / webhooks internos ---
# Token secreto para invocar /api/cron desde Railway cron o el worker.
CRON_SECRET=
